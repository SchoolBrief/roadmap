{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schoolbrief.io/schema/roadmap-v1.json",
  "title": "SchoolBrief Public Roadmap",
  "type": "object",
  "required": ["schema_version", "repository", "source_of_truth", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "repository": { "const": "SchoolBrief/roadmap" },
    "source_of_truth": { "const": "github_issues" },
    "description": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "type", "status", "url"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "type": { "enum": ["bug", "feature", "district"] },
          "status": { "enum": ["under_review", "planned", "in_progress", "verification", "released", "not_planned"] },
          "target": { "type": ["string", "null"] },
          "summary": { "type": ["string", "null"] },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
